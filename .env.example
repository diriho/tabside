# Copy to .env.local for local development. On Vercel, set the same names under
# Project Settings → Environment Variables (Production + Preview).

# ─── Browser (bundled into the client at build time — public values only) ───
# Your Supabase project: Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Optional: origin printed in QR codes. Leave empty to use the address the admin is browsing on.
VITE_PUBLIC_APP_URL=
# Optional: Stripe publishable key (checkout itself redirects via the API).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Server only (the /api function) — NEVER prefix these with VITE_ ───
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret / service-role key: bypasses RLS. Server only.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Stripe secret key (sk_test_… until you go live) and webhook signing secret.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe Checkout returns guests. On Vercel this defaults to your production domain.
APP_URL=http://localhost:5173
# Local development only.
API_PORT=8787
