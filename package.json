{
  "name": "tabside",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QR-code table ordering with shared running tabs for restaurants and hotels.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "stripe:listen": "stripe listen --forward-to localhost:8787/api/stripe/webhook",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project ui",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x edge-runtime,vector,logflare,imgproxy",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local 2>/dev/null > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.50.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
