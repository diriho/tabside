# ─── Browser (exposed to the client bundle — only public values here) ───
# Supabase project URL and publishable/anon key. In local dev, "/supabase" routes through the
# Vite proxy (so phones on your network work too); in production use the full https URL.
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Stripe publishable key (test mode while developing). Optional: checkout redirects via the API.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Public origin used in QR codes. Defaults to the current browser origin.
VITE_PUBLIC_APP_URL=http://localhost:5173

# ─── Server only (Node API in server/) — NEVER prefix these with VITE_ ───
SUPABASE_URL=http://127.0.0.1:54321
# Service-role / secret key: bypasses RLS. Server only.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Stripe secret key (sk_test_… in development).
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret. With the Stripe CLI: `npm run stripe:listen` prints a whsec_… value.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe Checkout sends the guest back to.
APP_URL=http://localhost:5173
API_PORT=8787
